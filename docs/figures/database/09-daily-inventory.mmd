erDiagram
    direction LR
    private_inventory_acquisitions ||..o| private_inventory_daily_captures : "seller_namespace + marketplace_name + capture_date + acquisition_id"
    private_inventory_daily_captures ||--o{ private_inventory_items : "capture_id"

    private_inventory_acquisitions["private.inventory_acquisitions"] {
        local_uuid id PK "NN"
        nonblank seller_namespace "NN"
        nonblank amazon_scope "NN"
        nonblank marketplace_id "NN"
        text marketplace_name "NN"
        date capture_date "NN"
        text report_type "NN"
        nonblank report_id "NN"
        nonblank report_document_id "NN"
        timestamp_with_time_zone report_created_at "NN"
        timestamp_with_time_zone downloaded_at "NN"
        sha256 document_sha256 "NN"
        jsonb document "NN"
        jsonb api_metadata "NN"
        timestamp_with_time_zone created_at "NN"
    }

    private_inventory_daily_captures["private.inventory_daily_captures"] {
        local_uuid id PK "NN"
        nonblank seller_namespace FK "NN"
        text marketplace_name FK "NN"
        date capture_date FK "NN"
        local_uuid acquisition_id FK "NN"
        nonblank preprocess_version "NN"
        integer row_count "NN"
        jsonb diagnostics "NN"
        timestamp_with_time_zone created_at "NN"
    }

    private_inventory_items["private.inventory_items"] {
        local_uuid capture_id PK, FK "NN"
        text sku PK "NN"
        integer source_line_number "NN"
        date snapshot_date "NULL"
        bigint available_quantity "NULL"
        bigint fba_supply_quantity "NULL"
        bigint inbound_quantity "NULL"
        bigint inbound_working_quantity "NULL"
        bigint inbound_shipped_quantity "NULL"
        bigint inbound_received_quantity "NULL"
        bigint reserved_quantity "NULL"
        bigint reserved_transfer_quantity "NULL"
        bigint reserved_processing_quantity "NULL"
        bigint reserved_customer_order_quantity "NULL"
        bigint unfulfillable_quantity "NULL"
        numeric sales_amount_90d "NULL"
        bigint units_shipped_90d "NULL"
        text currency "NULL"
        text health_status "NULL"
        bigint minimum_inventory_units "NULL"
        numeric days_of_supply "NULL"
        numeric total_days_of_supply "NULL"
        bigint recommended_ship_in_units "NULL"
        date recommended_ship_in_date "NULL"
        text recommended_action "NULL"
    }
