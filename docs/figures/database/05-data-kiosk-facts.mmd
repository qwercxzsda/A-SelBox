        jsonb native_dimensions "NN"
        text source_document_id "NULL"
        integer source_line_number "NN"
        timestamptz created_at "NN"
    }

    private_data_kiosk_pruned_versions["private.data_kiosk_pruned_versions"] {
        local_uuid version_id PK, FK "NN"
        timestamptz created_at "NN"
