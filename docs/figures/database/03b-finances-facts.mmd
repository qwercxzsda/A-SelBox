erDiagram
    direction LR
    private_finances_preprocess_batch_transactions o|..o| private_finances_transactions : "current_batch_id + id + current_version_id"
    private_finances_transactions ||..o{ private_finances_transaction_versions : "transaction_id"
    private_finances_transaction_versions ||..o{ private_finances_transaction_components : "version_id"

    private_finances_transactions["private.finances_transactions"] {
        local_uuid id PK, FK "NN"
        nonblank seller_namespace "NN"
        nonblank amazon_scope "NN"
        nonblank native_transaction_id "NN"
        local_uuid current_version_id FK "NULL"
        local_uuid current_batch_id FK "NULL"
        timestamp_with_time_zone created_at "NN"
    }

    private_finances_transaction_versions["private.finances_transaction_versions"] {
        local_uuid id PK "NN"
        local_uuid transaction_id FK "NN"
        sha256 content_sha256 "NN"
        date posted_date "NN"
        timestamp_with_time_zone posted_at "NN"
        nonblank marketplace_id "NN"
        text marketplace_name "NN"
        nonblank account_type "NN"
        nonblank transaction_type "NN"
        text transaction_status "NN"
        text deferred_transaction_id "NULL"
        text release_transaction_id "NULL"
        boolean activity_eligible "NN"
        exact_numeric total_amount "NN"
        text currency "NN"
        integer component_count "NN"
        timestamp_with_time_zone created_at "NN"
    }

    private_finances_transaction_components["private.finances_transaction_components"] {
        local_uuid id PK "NN"
        local_uuid version_id FK "NN"
        integer component_number "NN"
        allocation_category category "NN"
        nonblank component_type "NN"
        text accounting_subtype "NULL"
        text sku "NULL"
        exact_numeric amount "NN"
        exact_numeric quantity "NULL"
        exact_numeric fee_base "NULL"
        text[] breakdown_path "NN"
        integer item_index "NN"
        integer[] breakdown_indexes "NN"
        timestamp_with_time_zone created_at "NN"
    }

    private_finances_preprocess_batch_transactions["private.finances_preprocess_batch_transactions (reference)"] {
        local_uuid batch_id PK, FK "NN"
        local_uuid transaction_id PK, FK "NN"
    }
