erDiagram
    direction LR
    public_companies ||..o{ public_company_payout_reports : "company_id"
    public_companies ||--o{ private_payout_report_refresh_state : "company_id"

    public_company_payout_reports["public.company_payout_reports"] {
        local_uuid id PK "NN"
        local_uuid company_id FK "NN"
        text marketplace_name "NULL"
        text currency "NULL"
        date start_date "NN"
        date end_date "NN"
        text dataset_key "NN"
        nonblank change_reason "NN"
        integer component_count "NN"
        integer finances_version_count "NN"
        integer data_kiosk_version_count "NN"
        integer terms_version_count "NN"
        jsonb source_coverage "NN"
        calculated_amount source_amount "NN"
        calculated_amount fee_amount "NN"
        calculated_amount company_amount "NN"
        timestamp_with_time_zone created_at "NN"
    }

    private_payout_report_refresh_state["private.payout_report_refresh_state"] {
        local_uuid company_id PK, FK "NN"
        date month PK "NN"
        bigint requested_revision "NN"
        bigint completed_revision "NN"
        timestamp_with_time_zone next_attempt_at "NN"
        integer failure_count "NN"
        timestamp_with_time_zone last_attempt_at "NULL"
        timestamp_with_time_zone last_success_at "NULL"
        text last_error_sqlstate "NULL"
        text last_error_message "NULL"
        text last_failure_reason "NULL"
    }

    public_companies["public.companies (reference)"] {
        local_uuid id PK "NN"
    }
