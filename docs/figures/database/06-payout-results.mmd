erDiagram
    direction LR
    public_companies ||..o{ public_company_payout_reports : "company_id"
    public_companies ||--o{ private_payout_report_refresh_state : "company_id"
    public_company_payout_reports ||..o{ public_company_payout_report_components : "report_id"
    public_company_payout_reports ||--o{ private_payout_report_reconciliation : "report_id"

    private_payout_report_refresh_state["private.payout_report_refresh_state"] {
        local_uuid company_id PK, FK "NN"
        date month PK "NN first day"
        bigint requested_revision "NN default 1"
        bigint completed_revision "NN default 0"
        timestamptz next_attempt_at "NN"
        integer failure_count "NN default 0"
        timestamptz last_attempt_at "NULL"
        timestamptz last_success_at "NULL"
        text last_error_sqlstate "NULL"
        text last_error_message "NULL"
    }

    public_company_payout_reports["public.company_payout_reports"] {
        local_uuid id PK "NN"
        local_uuid company_id FK "NN"
        text currency "NULL"
        date start_date "NN"
        date end_date "NN"
        text dataset_key "NN"
        text[] marketplace_names "NN"
        nonblank report_name "NN"
        nonblank change_reason "NN"
        text calculation_version "NN"
        integer component_count "NN"
        integer reconciliation_count "NN"
        integer settlement_version_count "NN"
        integer data_kiosk_version_count "NN"
        integer terms_version_count "NN"
        calculated_amount source_amount "NN"
        calculated_amount fee_amount "NN"
        calculated_amount company_amount "NN"
        timestamptz created_at "NN"
    }

    public_company_payout_report_components["public.company_payout_report_components"] {
        local_uuid id PK "NN"
        local_uuid report_id FK "NN"
        integer row_number "NN"
        text source "NN"
        boolean authoritative "NN"
        local_uuid source_row_id "NN"
        local_uuid source_version_id "NN"
        local_uuid source_identity_id "NN"
        local_uuid sku_id FK "NN"
        local_uuid terms_version_id FK "NN"
        local_uuid fee_period_id FK "NULL"
        nonblank sku "NN"
        text marketplace_name "NULL"
        date activity_date "NN"
        nonblank component_type "NN"
        calculated_amount source_amount "NULL"
        calculated_amount quantity "NULL"
        calculated_amount fee_base "NULL"
        calculated_amount fee_rate_percent "NULL"
        calculated_amount fee_amount "NULL"
        calculated_amount company_amount "NULL"
        text resolution_status "NN"
    }

    private_payout_report_reconciliation["private.payout_report_reconciliation"] {
        local_uuid report_id PK, FK "NN"
        integer row_number PK "NN"
        nonblank seller_namespace "NN"
        date activity_date "NN"
        text marketplace_name "NULL"
        text currency "NN"
        calculated_amount settlement_category_amount "NN"
        calculated_amount selbox_category_amount "NN"
        calculated_amount data_kiosk_settlement_control "NN"
        calculated_amount data_kiosk_category_amount "NN"
        calculated_amount difference "NN"
        calculated_amount settlement_total "NN"
        calculated_amount accounted_total "NN"
    }

    public_companies["public.companies (reference)"] {
        local_uuid id PK "NN"
    }
