erDiagram
    direction LR
    private_finances_acquisitions ||..o{ private_finances_preprocess_batches : "acquisition_id"
    private_finances_transaction_versions ||..o{ private_finances_preprocess_batch_transactions : "transaction_id + version_id"
    private_finances_preprocess_batches ||--o{ private_finances_preprocess_batch_transactions : "batch_id"
    private_finances_transactions ||--o{ private_finances_preprocess_batch_transactions : "transaction_id"

    private_finances_acquisitions["private.finances_acquisitions"] {
        local_uuid id PK "NN"
        nonblank seller_namespace "NN"
        nonblank amazon_scope "NN"
        text api_version "NN"
        timestamp_with_time_zone capture_started_at "NN"
        timestamp_with_time_zone downloaded_at "NN"
        timestamp_with_time_zone posted_after "NN"
        timestamp_with_time_zone posted_before "NULL"
        date reconciliation_start_date "NULL"
        date reconciliation_end_date "NULL"
        text[] marketplace_ids "NN"
        jsonb api_metadata "NN"
        jsonb documents "NN"
        timestamp_with_time_zone created_at "NN"
    }

    private_finances_preprocess_batches["private.finances_preprocess_batches"] {
        local_uuid id PK "NN"
        local_uuid acquisition_id FK "NN"
        nonblank preprocess_version "NN"
        integer transaction_count "NN"
        integer component_count "NN"
        timestamp_with_time_zone created_at "NN"
    }

    private_finances_preprocess_batch_transactions["private.finances_preprocess_batch_transactions"] {
        local_uuid batch_id PK, FK "NN"
        local_uuid transaction_id PK, FK "NN"
        local_uuid version_id FK "NN"
        integer source_page_number "NN"
        integer source_record_number "NN"
    }

    private_finances_transaction_versions["private.finances_transaction_versions (reference)"] {
        local_uuid id PK "NN"
    }

    private_finances_transactions["private.finances_transactions (reference)"] {
        local_uuid id PK, FK "NN"
    }
