{
  "name": "user-webpage",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.5.1",
  "type": "module",
  "scripts": {
    "check": "corepack pnpm run format && corepack pnpm run lint && corepack pnpm run test && corepack pnpm run build:check && corepack pnpm run test:e2e",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:check": "VITE_SUPABASE_URL=https://example.invalid VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_build_check corepack pnpm run build",
    "format": "prettier --check . --ignore-unknown",
    "format:write": "prettier --write .",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mantine/core": "^9.6.1",
    "@mantine/hooks": "^9.6.1",
    "@tanstack/react-query": "^5.103.0",
    "@tanstack/react-table": "^9.2.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
